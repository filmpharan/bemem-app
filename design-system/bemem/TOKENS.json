{
  "metadata": {
    "name": "bemem Design System",
    "designSystemVersion": "1.0.0",
    "schemaVersion": 1,
    "date": "2026-11-06",
    "timezone": "Asia/Bangkok",
    "status": "awaiting-design-review",
    "runtimeAdoption": "not-applied",
    "format": "bemem-token-contract-v1 (not a claim of DTCG compliance)",
    "platform": {
      "expoSdk": 58,
      "reactNative": "0.88.1",
      "targets": [
        "android",
        "ios"
      ]
    },
    "units": {
      "layout": "React Native logical units (dp on Android, points on iOS)",
      "fontSize": "RN number with platform font scaling",
      "duration": "milliseconds",
      "opacity": "0..1 alpha, not percentage transparency",
      "blur": "provider-specific intensity; NOT pixels"
    },
    "authority": [
      "user-approved product specification and constraints",
      "MASTER.md and COMPONENTS.md",
      "TOKENS.json numeric values",
      "reviewed platform documentation",
      "skill recommendations"
    ],
    "reading": "Existing values are observations, not accessibility certification. Every proposed value requires UI adoption approval. Policy, references and shadow/blur paths are not StyleSheet props.",
    "noRuntimeImport": true,
    "changePolicy": {
      "existingNamespaces": "do-not-edit-without-review",
      "renames": "add new key; deprecate old key; do not silently rename",
      "dataMigration": "none; design tokens must not change Canvas/storage schema"
    },
    "futureExtensionPolicy": {
      "namespace": "future.pro (reserved; no PRO tokens designed)",
      "mustPreserve": [
        "header",
        "scan-surface",
        "touch-targets",
        "saved-draft-separation",
        "save-discard-cancel",
        "offline-card-access"
      ]
    }
  },
