      "composition": {
        "tintLayer": "One explicit RGBA overlay ABOVE provider material and BELOW content",
        "labelLayer": "Outside tint and clipping layer; opacity always 1",
        "shadowLayer": "Outer wrapper, not the clipped blur container",
        "disabledBlur": false,
        "layerLimitPerControl": 1
      }
    },
    "blur": {
      "status": "candidate-needs-provider-approval-and-device-validation",
      "none": {
        "enabled": false
      },
      "subtle": {
        "enabled": true,
        "intent": "subtle-static-local-effect",
        "expoBlurCandidate": {
          "iosIntensity": 24,
          "androidIntensity": 16,
          "androidBlurReductionFactor": 4,
          "androidBlurMethod": "dimezisBlurViewSdk31Plus",
          "androidMinimumSdkForBlur": 31
        }
      },
      "nativeGlassCandidate": {
        "minimumIosMajor": 26,
        "requiresBothCapabilityChecks": true,
        "glassEffectStyle": "regular",
        "colorSchemeBySemanticVariant": {
          "clear": "light",
          "dark": "dark"
        },
        "isInteractive": false,
        "numericIntensitySupported": false,
        "systemShadowOnly": true,
        "neverInferApiClearFromSemanticName": true
      },
      "fallback": {
        "mode": "opaque",
        "blur": false,
        "reason": "no approved provider, unsupported runtime, reduced transparency, failed contrast, or frame-budget failure"
      },
      "defaultBeforeProviderApproval": "opaqueFallback",
      "duringDrag": "stable opaque fallback selected once at gesture start; never recapture each frame",
      "maxSimultaneousLocalEffects": 2,
      "dependencyPolicy": "expo-glass-effect already declared; expo-blur is not a direct dependency and must not be installed without separate approval"
    },
