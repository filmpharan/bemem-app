{
  "metadata": {
    "id": "bemem-lagoon-glass",
    "name": "bemem — Lagoon Glass",
    "version": "2.0.0-rc.2",
    "schemaVersion": 1,
    "status": "implementation-awaiting-android-review",
    "date": "2026-11-07",
    "runtimeAdoption": "phase-1-fallback",
    "visualLanguage": "Lagoon selected by owner; token and implementation approval still pending",
    "supersedesVisualRulesOf": "bemem Design System v1.0, only after approval and adoption; old files preserved",
    "platform": {
      "expoSdk": 58,
      "reactNative": "0.88.1"
    },
    "format": "bemem native-oriented JSON contract, not a claim of DTCG compliance",
    "units": {
      "geometry": "RN logical units / CSS px in browser preview only",
      "opacity": "0..1 alpha",
      "duration": "ms",
      "blur": "provider-specific intensity, never CSS pixel equivalence"
    },
    "defaultThemeId": "pearl-gray",
    "themeIds": [
      "lagoon-mint",
      "blush-pink",
      "warm-beige",
      "lilac-dream",
      "sky-blue",
      "pearl-gray"
    ],
    "excludedThemeIds": [
      "peach-glow"
    ],
    "reference": "../../design-previews/bemem-redesign/lagoon.html",
    "cardThemePolicy": "never recolor, filter, crop or restyle actual card artwork from app color theme",
    "implementationCreated": true,
    "previousVersion": "../bemem-lagoon-glass/TOKENS.json"
  },
  "core": {
    "spacing": {
      "xs": 4,
      "sm": 8,
      "md": 12,
      "lg": 16,
      "xl": 20,
      "xxl": 24,
      "xxxl": 32
    },
    "radius": {
      "card": 23,
      "utility": 18,
      "gel": 22,
      "save": 20,
      "sheet": 24,
      "pill": 999
    },
    "typography": {
      "families": {
        "latin": "Manrope",
        "thai": "Noto Sans Thai"
      },
      "nativeRegistration": "future Text wrapper resolves installed family aliases; these are names, not a JS fontFamily array",
      "styles": {
        "wordmark": {
          "fontSize": 30,
          "lineHeight": 38,
          "fontWeight": "800",
          "letterSpacing": -1.2
        },
        "pageTitle": {
          "fontSize": 22,
          "lineHeight": 28,
          "fontWeight": "700",
          "letterSpacing": -0.6
        },
        "body": {
          "fontSize": 14,
          "lineHeight": 22,
          "fontWeight": "400"
        },
        "secondary": {
          "fontSize": 12,
          "lineHeight": 18,
          "fontWeight": "500"
        },
        "button": {
          "fontSize": 14,
          "lineHeight": 20,
          "fontWeight": "700"
        },
        "cardName": {
          "fontSize": 13,
          "lineHeight": 18,
          "fontWeight": "700"
        }
      }
    },
    "icons": {
      "size": 20,
      "fabSize": 24,
      "strokeWidth": 1.8,
      "family": "consistent outline vectors; no dependency chosen"
    },
    "geometry": {
      "header": {
        "heightMin": 70,
        "paddingHorizontal": 18,
        "gap": 8
      },
      "search": {
        "width": 48,
        "height": 48,
        "borderRadius": 18
      },
      "create": {
        "minHeight": 48,
        "paddingHorizontal": 15,
        "borderRadius": 18
      },
      "fab": {
        "width": 56,
        "height": 56,
        "borderRadius": 22
      },
      "save": {
        "minHeight": 56,
        "minWidth": 128,
        "paddingHorizontal": 20,
        "borderRadius": 20
      },
      "addCard": {
        "minHeight": 48,
        "paddingHorizontal": 18,
        "borderRadius": 20
      },
      "actionRail": {
        "horizontalInset": 20,
        "bottomInset": 24,
        "gapMin": 16
      },
      "canvasChrome": {
        "horizontalInset": 18,
        "topGap": 16
      },
      "card": {
        "borderRadius": 23
      },
      "textScaling": "minHeight is not fixed height; grow text controls upwards from bottom anchor, not by mutating logical grid"
    },
    "materials": {
      "utility": {
        "fillAlpha": 0.7,
        "pressedAlpha": 0.8,
        "disabledAlpha": 0.84,
        "highlightTopAlpha": 0.82,
        "highlightBodyAlpha": 0.36,
        "rimOuterAlpha": 0.92,
        "rimInnerAlpha": 0.28,
        "bottomOcclusionAlpha": 0.12,
        "labelBandMaxHighlightAlpha": 0.04,
        "foreground": "{semantic.text.primary}",
        "fill": "{semantic.glass.lightTint}"
      },
      "utilitySelected": {
        "fillAlpha": 0.78,
        "pressedAlpha": 0.8,
        "disabledAlpha": 0.84,
        "highlightTopAlpha": 0.82,
        "highlightBodyAlpha": 0.36,
        "rimOuterAlpha": 0.92,
        "rimInnerAlpha": 0.5,
        "bottomOcclusionAlpha": 0.12,
        "labelBandMaxHighlightAlpha": 0.04,
        "foreground": "{semantic.text.primary}",
        "fill": "{semantic.glass.lightTint}"
      },
      "gel": {
        "fillAlpha": 0.7,
        "pressedAlpha": 0.78,
        "disabledAlpha": 0.84,
        "highlightTopAlpha": 0.96,
        "highlightBodyAlpha": 0.48,
        "rimOuterAlpha": 0.92,
        "rimInnerAlpha": 0.28,
        "bottomOcclusionAlpha": 0.16,
        "labelBandMaxHighlightAlpha": 0.04,
        "foreground": "{semantic.text.primary}",
        "fill": "{semantic.glass.lightTint}"
      },
      "action": {
        "fillAlpha": 0.86,
        "pressedAlpha": 0.96,
        "disabledAlpha": 0.84,
        "highlightTopAlpha": 0.72,
        "highlightBodyAlpha": 0.18,
        "rimOuterAlpha": 0.76,
        "rimInnerAlpha": 0.35,
        "bottomOcclusionAlpha": 0.17,
        "labelBandMaxHighlightAlpha": 0.04,
        "foreground": "{semantic.text.onAction}",
        "fill": "{semantic.glass.actionTint}"
      },
      "inactive": {
        "fillAlpha": 0.84,
        "pressedAlpha": 0.96,
        "disabledAlpha": 0.84,
        "highlightTopAlpha": 0.25,
        "highlightBodyAlpha": 0,
        "rimOuterAlpha": 0.92,
        "rimInnerAlpha": 0.16,
        "bottomOcclusionAlpha": 0.04,
        "labelBandMaxHighlightAlpha": 0.04,
        "foreground": "{semantic.text.disabled}",
        "fill": "{semantic.glass.lightTint}",
        "shadowEnabled": false,
        "blurEnabled": false
      }
    },
    "materialConstruction": {
      "order": [
        "outer shadow",
        "clipped backdrop material or opaque fallback",
        "theme tint",
        "fixed gel depth gradient at edges",
        "specular top-left patch",
        "outer and inner rim",
        "independent full-opacity icon/label"
      ],
      "lightDirection": "upper-left, fixed; never pointer-following",
      "labelProtection": "No highlight overlay above content; safe band y 36%-78%, effective highlight alpha <=0.04",
      "nativeMapping": "See MATERIALS.md; no literal DOM/backdrop-filter props in Native",
      "noShimmer": true,
      "noGlowPulse": true,
      "noAnimatedRefraction": true
    },
    "shadow": {
      "rest": {
        "offsetX": 0,
        "offsetY": 9,
        "blurRadius": 24,
        "spreadDistance": -9,
        "alpha": 0.25,
        "tint": "{semantic.shadow.tint}"
      },
      "pressed": {
        "offsetX": 0,
        "offsetY": 4,
        "blurRadius": 12,
        "spreadDistance": -5,
        "alpha": 0.22,
        "tint": "{semantic.shadow.tint}"
      },
      "legacy": {
        "iosShadowRadius": 10,
        "iosOffsetY": 6,
        "androidElevation": 3
      },
      "rule": "one outer shadow renderer; no stacking system shadow plus custom shadow"
    },
    "motion": {
      "pressMs": 80,
      "releaseMs": 140,
      "smallSurfaceMs": 160,
      "reducedMs": 0,
      "animatedProperties": [
        "opacity"
      ],
      "neverAnimate": [
        "blur",
        "shadowRadius",
        "controlGeometry",
        "specularPosition",
        "canvasGeometry"
      ],
      "noDelayBeforeCardOpen": true
    },
    "statePriority": [
      "busy",
      "disabled",
      "pressed",
      "active",
      "default"
    ],
    "touch": {
      "iosMin": 44,
      "androidMin": 48,
      "spacingMin": 8,
      "focusStrokeWidth": 2,
      "fontScaleTargetPercent": 200
    },
    "scan": {
      "background": "#ffffff",
      "foreground": "#000000",
      "opacity": 1,
      "qrQuietZoneModules": 4,
      "code128QuietZone": "follow chosen renderer/symbology; not QR margin",
      "effectsAllowed": false,
      "decorationAllowed": false,
      "overlayAllowed": false,
      "roundedCodeClipAllowed": false
    }
  },
  "semantic": {
    "canvas": {
      "base": "{palette.canvas.base}",
      "high": "{palette.canvas.high}",
      "low": "{palette.canvas.low}"
    },
    "surface": {
      "base": "{palette.surface.base}",
      "reducedTransparency": "{palette.surface.reducedTransparency}"
    },
    "text": {
      "primary": "{palette.text.primary}",
      "secondary": "{palette.text.secondary}",
      "onAction": "{palette.text.onAction}",
      "disabled": "{palette.text.disabled}"
    },
    "action": {
      "primary": "{palette.action.primary}",
      "deep": "{palette.action.deep}",
      "soft": "{palette.action.soft}"
    },
    "glass": {
      "lightTint": "{palette.glass.lightTint}",
      "actionTint": "{palette.glass.actionTint}"
    },
    "rim": {
      "outer": "{palette.rim.outer}",
      "inner": "{palette.rim.inner}",
      "boundary": "{palette.rim.boundary}"
    },
    "highlight": {
      "specular": "{palette.highlight.specular}",
      "body": "{palette.highlight.body}"
    },
    "shadow": {
      "tint": "{palette.shadow.tint}"
    },
    "grid": {
      "line": "{palette.grid.line}"
    },
    "status": {
      "error": "#b42318",
      "success": "#176b4a"
    }
  },
