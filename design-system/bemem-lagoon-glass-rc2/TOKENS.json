  "components": {
    "search": {
      "geometry": "{core.geometry.search}",
      "typography": "{core.typography.styles.button}",
      "contentOpacity": 1,
      "roles": {
        "default": "utility",
        "active": "utilitySelected"
      },
      "states": {
        "default": {
          "interactive": true
        },
        "pressed": {
          "interactive": true,
          "style": "apply pressedAlpha of current material; no geometry transform"
        },
        "active": {
          "interactive": true,
          "accessibilityState": "selected or expanded; do not rename label"
        },
        "disabled": {
          "interactive": false,
          "material": "{core.materials.inactive}",
          "foreground": "{semantic.text.disabled}"
        }
      },
      "label": "Search",
      "activeLabel": "Close search",
      "busySupported": false,
      "icon": "{core.icons.size}",
      "placement": "header-right-before-create"
    },
    "create": {
      "geometry": "{core.geometry.create}",
      "typography": "{core.typography.styles.button}",
      "contentOpacity": 1,
      "roles": {
        "default": "utility",
        "active": "action"
      },
      "states": {
        "default": {
          "interactive": true
        },
        "pressed": {
          "interactive": true,
          "style": "apply pressedAlpha of current material; no geometry transform"
        },
        "active": {
          "interactive": true,
          "accessibilityState": "selected or expanded; do not rename label"
        },
        "disabled": {
          "interactive": false,
          "material": "{core.materials.inactive}",
          "foreground": "{semantic.text.disabled}"
        }
      },
      "label": "Create",
      "labelConstantInAllModes": false,
      "busySupported": false,
      "placement": "header-top-right",
      "labelByMode": {
        "home": "Create",
        "create": "Create PRO"
      }
    },
    "fab": {
      "geometry": "{core.geometry.fab}",
      "typography": "{core.typography.styles.button}",
      "contentOpacity": 1,
      "roles": {
        "default": "gel"
      },
      "states": {
        "default": {
          "interactive": true
        },
        "pressed": {
          "interactive": true,
          "style": "apply pressedAlpha of current material; no geometry transform"
        },
        "disabled": {
          "interactive": false,
          "material": "{core.materials.inactive}",
          "foreground": "{semantic.text.disabled}"
        }
      },
      "label": "Add Card",
      "icon": "{core.icons.size}",
      "activeSupported": false,
      "busySupported": false,
      "placementByMode": {
        "homeEmpty": "bottom-right",
        "homeHasCards": "hidden",
        "create": "bottom-left"
      },
      "visibilityContract": "Caller owns real total-card count; filtered search results never determine empty wallet."
    },
    "save": {
      "geometry": "{core.geometry.save}",
      "typography": "{core.typography.styles.button}",
      "contentOpacity": 1,
      "roles": {
        "default": "action"
      },
      "states": {
        "default": {
          "interactive": true
        },
        "pressed": {
          "interactive": true,
          "style": "apply pressedAlpha of current material; no geometry transform"
        },
        "disabled": {
          "interactive": false,
          "material": "{core.materials.inactive}",
          "foreground": "{semantic.text.disabled}"
        },
        "busy": {
          "interactive": false,
          "material": "action",
          "foreground": "{semantic.text.onAction}",
          "label": "Saving…",
          "preserveLabelSpace": true,
          "accessibilityState": {
            "busy": true,
            "disabled": true
          }
        }
      },
      "label": "Save",
      "dirtyDraftOnly": true,
      "successRule": "only actual wallet commit success; no timer-driven success",
      "activeSupported": false,
      "placement": "action-rail-bottom-right"
    },
    "addCard": {
      "geometry": "{core.geometry.addCard}",
      "typography": "{core.typography.styles.button}",
      "contentOpacity": 1,
      "roles": {
        "default": "gel"
      },
      "states": {
        "default": {
          "interactive": true
        },
        "pressed": {
          "interactive": true,
          "style": "apply pressedAlpha of current material; no geometry transform"
        },
        "disabled": {
          "interactive": false,
          "material": "{core.materials.inactive}",
          "foreground": "{semantic.text.disabled}"
        },
        "busy": {
          "interactive": false,
          "material": "gel",
          "label": "Adding…",
          "preserveLabelSpace": true,
          "accessibilityState": {
            "busy": true,
            "disabled": true
          }
        }
      },
      "label": "Add Card",
      "futureOnly": true
    },
    "back": {
      "geometry": "{core.geometry.search}",
      "placement": "header-right-before-create-pro",
      "label": "Back to Home",
      "behavior": "existing unsaved changes guard"
    }
  },
  "platformRendering": {
    "status": "policy-only-not-runtime-implementation",
    "defaultWithoutFurtherApproval": "opaque embossed gel fallback using existing RN primitives",
    "opaqueFallback": {
      "fill": "{semantic.surface.reducedTransparency}",
      "actionFill": "{semantic.action.primary}",
      "labelUnchanged": true,
      "keepSpecular": true,
      "keepRim": true,
      "keepSoftShadow": true,
      "keepGelGradient": true,
      "actualBlur": false
    },
    "browserSimulation": {
      "backdropBlurPx": 18,
      "actionBlurPx": 14,
      "cssNotNative": true
    },
    "iosGlass": {
      "candidatePackage": "expo-glass-effect",
      "alreadyDirectDependency": true,
      "minimumOsMajor": 26,
      "requiredChecks": [
        "isLiquidGlassAvailable",
        "isGlassEffectAPIAvailable"
      ],
      "glassEffectStyle": "regular",
      "isInteractive": false,
      "numericBlurIntensitySupported": false,
      "uniformityRule": "use only if the resulting material matches Lagoon across palettes; otherwise fallback"
    },
    "optionalExpoBlur": {
      "candidatePackage": "expo-blur",
      "directDependencyPresent": false,
      "separateApprovalRequired": true,
      "iosIntensity": 24,
      "androidIntensity": 16,
      "androidBlurReductionFactor": 4,
      "androidMethod": "dimezisBlurViewSdk31Plus",
      "androidMinApi": 31,
      "requiresSharedBlurTargetView": true
    },
    "accessibility": {
      "reduceMotion": "core.motion.reducedMs; no decorative progress motion required",
      "reduceTransparencyIos": "opaque fallback and observe changes",
